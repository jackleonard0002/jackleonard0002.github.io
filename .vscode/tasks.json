{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Whimsical Wands site",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"http.server",
				"5500"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Launch Whimsical Wands homepage",
			"type": "shell",
			"command": "Start-Process",
			"args": [
				"index.html"
			],
			"group": "build"
		}
	]
}